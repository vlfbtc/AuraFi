# Catálogo de configuração do servidor AuraFi.
# Copie para um arquivo .env local ou configure no secret manager. Nunca
# versione chaves, senhas, tokens ou o pepper real.

# Ambiente e transporte HTTP
AURAFI_ENV=production
AURAFI_API_HOST=0.0.0.0
AURAFI_API_PORT=8000
AURAFI_ALLOWED_ORIGINS=https://app.aurafi.com.br
AURAFI_TRUST_PROXY_HEADERS=true

# Persistência de instância única (Render persistent disk)
AURAFI_DB_PATH=/data/aurafi.sqlite3
AURAFI_ALLOW_SELF_SIGNUP=true

# OTP real via Resend SMTP
AURAFI_OTP_PROVIDER=smtp
AURAFI_OTP_SMTP_HOST=smtp.resend.com
AURAFI_OTP_SMTP_PORT=587
AURAFI_OTP_SMTP_STARTTLS=true
AURAFI_OTP_SMTP_SSL=false
AURAFI_OTP_SMTP_TIMEOUT=10
AURAFI_OTP_FROM_EMAIL=nao-responder@aurafi.com.br
AURAFI_OTP_SMTP_USERNAME=resend
AURAFI_OTP_SMTP_PASSWORD=SUBSTITUA_PELA_CHAVE_RESEND_NO_SECRET_MANAGER
AURAFI_OTP_HMAC_PEPPER=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_BYTES_OU_MAIS
AURAFI_OTP_REQUEST_LIMIT=5
AURAFI_OTP_VERIFY_LIMIT=10

# Dados reais, somente leitura, da DeFiLlama
AURAFI_ENABLE_MARKET_NETWORK=true
AURAFI_MARKET_MODE=live
AURAFI_MARKET_BASE_URL=https://yields.llama.fi
AURAFI_MARKET_ENDPOINT=/pools

# Hub conversacional real via Claude Messages API
AURAFI_LLM_PROVIDER=anthropic
AURAFI_ANTHROPIC_API_KEY=SUBSTITUA_PELA_CHAVE_ANTHROPIC_NO_SECRET_MANAGER
AURAFI_ANTHROPIC_MODEL=claude-sonnet-5
AURAFI_ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
AURAFI_ANTHROPIC_VERSION=2023-06-01
AURAFI_ANTHROPIC_MAX_TOKENS=700
AURAFI_ANTHROPIC_TIMEOUT=20
AURAFI_ANTHROPIC_MAX_RESPONSE_BYTES=1048576
AURAFI_LLM_REQUEST_LIMIT=30

# Remoção automática de códigos vencidos, respostas antigas de idempotência e
# contas nunca confirmadas. Em produção só roda com true; fora dela, off desliga.
AURAFI_RETENTION_PURGE=false

# Exclusivo de desenvolvimento local; nunca configure em produção:
# AURAFI_DEV_OTP_CODE=123456

# PostgreSQL gerenciado (opcional); tem prioridade sobre AURAFI_DB_PATH quando definida:
# DATABASE_URL=postgresql://user:password@host:5432/aurafi

# Evolução planejada para escala horizontal (ainda sem adapter ativo):
# REDIS_URL=redis://host:6379
