# Nunca coloque valores reais neste arquivo versionado. Injete segredos pelo
# secret manager da plataforma de hospedagem.
AURAFI_ENV=production
AURAFI_API_HOST=0.0.0.0
AURAFI_API_PORT=8000
AURAFI_ALLOWED_ORIGINS=https://app.seu-dominio.example
AURAFI_TRUST_PROXY_HEADERS=true
AURAFI_DB_PATH=/data/aurafi.sqlite3

# Cadastro por OTP. Desative para operar somente com contas provisionadas.
AURAFI_ALLOW_SELF_SIGNUP=true
AURAFI_OTP_PROVIDER=smtp
# Resend SMTP: https://resend.com/docs/send-with-smtp
AURAFI_OTP_SMTP_HOST=smtp.resend.com
AURAFI_OTP_SMTP_PORT=587
AURAFI_OTP_SMTP_STARTTLS=true
AURAFI_OTP_SMTP_SSL=false
# Para o primeiro teste, use onboarding@resend.dev e envie apenas para o e-mail
# da conta Resend. Depois de verificar aurafi.com.br, use um remetente desse domínio.
AURAFI_OTP_FROM_EMAIL=onboarding@resend.dev
AURAFI_OTP_SMTP_USERNAME=resend
# Cole a chave Resend completa (re_...), exibida somente na criação da API key.
AURAFI_OTP_SMTP_PASSWORD=
# Segredo aleatório estável, injetado pelo secret manager; não reutilize senha SMTP.
AURAFI_OTP_HMAC_PEPPER=
AURAFI_OTP_REQUEST_LIMIT=5
AURAFI_OTP_VERIFY_LIMIT=10

# Mercado somente leitura. Host e endpoint são validados pela aplicação.
AURAFI_ENABLE_MARKET_NETWORK=true
AURAFI_MARKET_MODE=live
AURAFI_MARKET_BASE_URL=https://yields.llama.fi
AURAFI_MARKET_ENDPOINT=/pools

# Hub conversacional real. O provider é obrigatório em produção.
AURAFI_LLM_PROVIDER=anthropic
AURAFI_LLM_REQUEST_LIMIT=30
AURAFI_ANTHROPIC_API_KEY=
AURAFI_ANTHROPIC_MODEL=claude-sonnet-5
AURAFI_ANTHROPIC_VERSION=2023-06-01
AURAFI_ANTHROPIC_TIMEOUT=20
AURAFI_ANTHROPIC_MAX_TOKENS=700
